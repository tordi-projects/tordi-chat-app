# Copy this file to `.env` and fill in your real values.
# `.env` itself is listed in .gitignore — never commit it.

# --- Email (used to send registration/login verification codes) -----------
# Leave EMAIL_HOST_USER blank to just print codes to the console (dev mode).
# Example for Gmail: create an "App Password" (not your normal password) at
# https://myaccount.google.com/apppasswords, then:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your_16_char_app_password
#   EMAIL_USE_TLS=true
# Any other SMTP provider (SendGrid, Mailgun, your host's SMTP, etc.) works
# the same way — just point EMAIL_HOST/PORT/USER/PASSWORD at it.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tordigbarabe100@gmail.com
EMAIL_HOST_PASSWORD=zryqsfnmodxuwjms
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Tordi <tordigbarabe100@gmail.com>

# --- Twilio (optional — not used by the core login flow anymore) ----------
# Registration/login now happens by email. These are left here in case you
# add SMS features later (e.g. verifying a linked phone number).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_USE_WHATSAPP=false
TWILIO_WHATSAPP_FROM=
